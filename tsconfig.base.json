{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@ashetm/ng-ether": ["packages/ng-ether/src/index.ts"],
      "@ashetm/ng-ether/ngrx": ["packages/ng-ether/ngrx/src/index.ts"],
      "@ashetm/ng-ether/router": ["packages/ng-ether/router/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
